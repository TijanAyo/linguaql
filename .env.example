# ============================================================================
# LinguaQL environment. Copy to `.env` and fill in. Only ANTHROPIC_API_KEY is
# required to run the full pipeline (it powers the SQL generator, Node 2).
# ============================================================================

# --- Generator LLM (REQUIRED for the query pipeline) ---
ANTHROPIC_API_KEY=
GENERATOR_MODEL=claude-opus-4-8

# --- App's own vector database (pgvector). Docker Compose sets this for you. ---
# For local (non-Docker) runs, point at a local Postgres, or use the in-memory
# vector store instead (VECTOR_STORE=inmemory) to run with no app DB at all.
DATABASE_URL=postgresql://linguaql:linguaql@app-postgres:5432/linguaql
VECTOR_STORE=pgvector          # pgvector | inmemory

# --- Embeddings ---
# Default embedder is a zero-dependency deterministic HashingEmbedder (needs no
# keys, no model download). Set EMBEDDER to upgrade quality:
#   hashing  -> built-in, default
#   local    -> sentence-transformers all-MiniLM-L6-v2 (pip install sentence-transformers)
#   openai   -> text-embedding-3-small (requires OPENAI_API_KEY)
EMBEDDER=openai
EMBED_DIM=384                  # 384 for hashing/local(MiniLM); 1536 for openai
OPENAI_API_KEY=

# --- Synonym expansion  ---
# Deterministic WordNet synonyms enrich column docs before embedding.
#   none     -> off (default)
#   wordnet  -> nltk WordNet (corpus auto-downloaded on first ingest)
SYNONYMS=none

# --- Pipeline knobs ---
MAX_RETRIES=2                  # self-correction loop cap (bounds per-query Opus spend)
RETRIEVE_TOP_K=15
SOURCE_QUERY_TIMEOUT=10        # seconds, executor query timeout

# --- Public-demo hardening ---
# Debug hooks power the "Ask (force guardrail)" escape hatch. Keep OFF in a
# hosted deployment so nobody can drive the engine into the verification path;
# set true only for local demos.
ENABLE_DEBUG_HOOKS=false
# Global daily budget: max queries across ALL users per day (protects the funded
# Anthropic wallet). In-memory; resets on restart or at the day rollover.
DAILY_QUERY_CAP=100
# Per-IP throttle (slowapi): burst guard + each visitor's share of the pool.
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=10

# --- Frontend (Next.js) — set in the frontend service's environment ---
# NEXT_PUBLIC_API_BASE=http://localhost:8000
# NEXT_PUBLIC_DEV_MODE=true    # shows the "Ask (force guardrail)" button (dev only)

# --- Credential encryption ---
# Fernet master key for encrypting source-DB credentials at rest. If empty, an
# ephemeral key is generated at startup (dev only). Generate a persistent one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
